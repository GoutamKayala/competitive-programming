import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int m=sc.nextInt();
        
        int arr1[]=new int[n];
        int arr2[]=new int[m];
        
        for(int i=0;i<n;i++)
            arr1[i]=sc.nextInt();
            
        for(int i=0;i<m;i++)
            arr2[i]=sc.nextInt();
            
        int arr[]=new int[n+m];
        
        int i=0,j=0,k=0;
        while(i<n && j<m){
            if(arr1[i]<=arr2[j]){
                arr[k++]=arr1[i++];
            }
            else{
                arr[k++]=arr2[j++];
            }
        }
        
        while(i<n)
            arr[k++]=arr1[i++];
        while(j<m)
            arr[k++]=arr2[j++];
            
        if(arr.length % 2 ==0){
            double ans = ((double)arr[(arr.length/2)-1] + arr[arr.length/2]) / 2.0;
            System.out.println(ans);
        }
        else{
            double ans=(double) arr[arr.length/2];
            System.out.println(ans);       
        }
        
    }
}

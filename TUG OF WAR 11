import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];
        int total = 0;

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
            total += arr[i];
        }

        int targetSize = n / 2;
        boolean[][] dp = new boolean[targetSize + 1][total + 1];

        dp[0][0] = true;

        for (int weight : arr) {
            for (int k = targetSize; k >= 1; k--) {
                for (int sum = total; sum >= weight; sum--) {
                    if (dp[k - 1][sum - weight]) {
                        dp[k][sum] = true;
                    }
                }
            }
        }

        int minDiff = Integer.MAX_VALUE;

        for (int sum = 0; sum <= total; sum++) {
            if (dp[targetSize][sum]) {
                minDiff = Math.min(minDiff, Math.abs(total - 2 * sum));
            }
        }

        System.out.println(minDiff);
    }
}

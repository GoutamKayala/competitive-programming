import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int min=Integer.MAX_VALUE;
        int max=Integer.MIN_VALUE;
        int minInd=0,maxInd=0;
        for(int i=0;i<n;i++){
            if(arr[i]<min){
                min=arr[i];
                minInd=i;
            }
            if(arr[i]>max){
                max=arr[i];
                maxInd=i;
            }
        }
        int temp=arr[minInd];
        arr[minInd]=arr[maxInd];
        arr[maxInd]=temp;
        
        for(int i=0;i<n;i++){
            System.out.print(arr[i]+" ");
        }
    }
}

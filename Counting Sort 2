import java.io.*;
import java.util.*;

public class Solution {
    public static void main(String[] args) throws IOException {
        Scanner sc = new Scanner(System.in);
        
        if (!sc.hasNextInt()) return;
        int n = sc.nextInt();
        int nums[] = new int[n];
        
        int maxVal = Integer.MIN_VALUE;
        for (int i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
            if (maxVal < nums[i]) {
                maxVal = nums[i];
            }
    }
        
       
        int aux[] = new int[maxVal + 1];
        for (int i = 0; i < n; i++) {
            aux[nums[i]]++;
        }
        
        
        for (int i = 1; i <= maxVal; i++) {
            aux[i] += aux[i - 1];
        }
        
        
        int res[] = new int[n];
        for (int i = n - 1; i >= 0; i--) { 
            res[aux[nums[i]] - 1] = nums[i];
            aux[nums[i]]--;
        }
        
        
        for (int i = 0; i < n; i++) {
            System.out.print(res[i] + " ");
        }
    }
}

import java.io.*;
import java.util.*;

public class Solution {
    public static int count(int num,int arr[]){
        int countnum=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]==num){
                countnum++;
            }
        }
        if(countnum > arr.length/2){
            return num;
        }
        else{
            return -1;
        }
    }
    public static void main(String[] args) {
       Scanner sc=new Scanner(System.in);
       int n=sc.nextInt();
       int arr[]=new int[n];
       for(int i=0;i<n;i++){
        arr[i]=sc.nextInt();
       }
       int ans=-1;
       for(int i=0;i<n;i++){
        int isTrue=count(arr[i],arr);
        if(isTrue!=-1){
            ans=isTrue;
        }
        
        }
        System.out.println(ans);
    }
}
